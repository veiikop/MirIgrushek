<Window x:Class="MirIgrushek.Windows.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="МирИгрушек — Список товаров"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Arial"
        Background="{StaticResource MainBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Шапка ===================== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Логотип на главной форме -->
            <Image Grid.Column="0" Source="pack://application:,,,/Resources/logo.png"
                   Height="56" Stretch="Uniform" VerticalAlignment="Center" />

            <TextBlock Grid.Column="1" Text="Список товаров"
                       FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="16,0,0,0" />

            <!-- ФИО пользователя в правом верхнем углу -->
            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <TextBlock x:Name="UserNameText" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Right" />
                <TextBlock x:Name="RoleText" FontSize="12" Foreground="#555"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <!-- ===================== Панель управления ===================== -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Поиск, фильтр, сортировка (видимы для менеджера и администратора) -->
            <WrapPanel x:Name="ToolsPanel" Grid.Column="0" Orientation="Horizontal">
                <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                    <TextBlock Text="Поиск:" FontSize="12" />
                    <TextBox x:Name="SearchBox" Width="260" Height="30"
                             VerticalContentAlignment="Center" Padding="6,0"
                             TextChanged="Filter_Changed" />
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                    <TextBlock Text="Поставщик:" FontSize="12" />
                    <ComboBox x:Name="SupplierFilter" Width="180" Height="30"
                              SelectionChanged="Filter_Changed" />
                </StackPanel>

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Сортировка по остатку:" FontSize="12" />
                    <ComboBox x:Name="SortBox" Width="200" Height="30"
                              SelectionChanged="Filter_Changed" />
                </StackPanel>
            </WrapPanel>

            <!-- Кнопки действий (зависят от роли) -->
            <StackPanel x:Name="ActionPanel" Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Bottom">
                <Button x:Name="OrdersButton" Content="Заказы"
                        Style="{StaticResource StandardButton}"
                        Click="OrdersButton_Click" Visibility="Collapsed" />
                <Button x:Name="AddProductButton" Content="Добавить товар"
                        Style="{StaticResource AccentButton}"
                        Click="AddProductButton_Click" Visibility="Collapsed" />
                <Button x:Name="DeleteProductButton" Content="Удалить товар"
                        Style="{StaticResource StandardButton}"
                        Click="DeleteProductButton_Click" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- ===================== Список товаров ===================== -->
        <ListView x:Name="ProductsList" Grid.Row="2"
                  BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="ProductsList_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="2" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!-- Карточка товара по образцу: Фото | Текст | Действующая скидка -->
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="8"
                            Background="{Binding Converter={StaticResource ProductRowBackgroundConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <!-- Фото товара (с заглушкой при отсутствии) -->
                            <Border Grid.Column="0" BorderBrush="#999" BorderThickness="1"
                                    Width="100" Height="80" HorizontalAlignment="Center">
                                <Image Source="{Binding PhotoPath, Converter={StaticResource PhotoConverter}}"
                                       Stretch="Uniform" />
                            </Border>

                            <!-- Текстовый блок карточки -->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontWeight="Bold" FontSize="14" TextWrapping="Wrap">
                                    <Run Text="{Binding CategoryName}" />
                                    <Run Text=" | " />
                                    <Run Text="{Binding ProductName}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                           Foreground="#444" Margin="0,2,0,2" MaxHeight="40" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Производитель: " FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ProducerName}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Поставщик: " FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SupplierName}" />
                                </StackPanel>

                                <!-- Цена: при скидке основная цена зачёркнута и красная,
                                     рядом итоговая цена чёрным -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Цена: " FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N2} ₽}"
                                               TextDecorations="Strikethrough" Foreground="Red"
                                               Visibility="{Binding Discount, Converter={StaticResource DiscountToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:N2} ₽}"
                                               Foreground="Black" Margin="6,0,0,0"
                                               Visibility="{Binding Discount, Converter={StaticResource DiscountToVisibilityConverter}}" />
                                    <!-- Если скидки нет, показываем обычную цену -->
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N2} ₽}"
                                               Foreground="Black">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDiscount}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Единица измерения: " FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding UnitName}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Количество на складе: " FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StockQuantity}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Действующая скидка -->
                            <Border Grid.Column="2" BorderBrush="#999" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" Margin="4,8">
                                    <TextBlock Text="Действующая скидка" FontSize="11"
                                               TextWrapping="Wrap" TextAlignment="Center" />
                                    <TextBlock Text="{Binding Discount, StringFormat={}{0}%}"
                                               FontSize="20" FontWeight="Bold"
                                               TextAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ===================== Нижняя панель ===================== -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="На главную (выход)" Style="{StaticResource StandardButton}"
                    Click="LogoutButton_Click" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="#555" />
        </StackPanel>
    </Grid>
</Window>
