<Window x:Class="MirIgrushek.Windows.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар"
        Height="640" Width="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Arial"
        Background="{StaticResource MainBackgroundBrush}"
        ResizeMode="CanMinimize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Text="Добавление товара"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Фото товара -->
                <TextBlock Text="Фото товара:" FontWeight="SemiBold" />
                <Border BorderBrush="#999" BorderThickness="1" Width="300" Height="200"
                        HorizontalAlignment="Left" Margin="0,4,0,4">
                    <Image x:Name="PhotoImage" Stretch="Uniform" />
                </Border>
                <Button Content="Выбрать изображение" Style="{StaticResource StandardButton}"
                        HorizontalAlignment="Left" Click="ChoosePhoto_Click" />

                <!-- Артикул (ID): при добавлении генерируется, при редактировании только чтение -->
                <TextBlock Text="Артикул:" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox x:Name="ArticleBox" Height="30" VerticalContentAlignment="Center" Padding="6,0" />

                <TextBlock Text="Наименование товара:" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox x:Name="NameBox" Height="30" VerticalContentAlignment="Center" Padding="6,0" />

                <TextBlock Text="Категория товара:" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ComboBox x:Name="CategoryBox" Height="30" />

                <TextBlock Text="Описание товара:" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox x:Name="DescriptionBox" Height="60" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6" />

                <TextBlock Text="Производитель:" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ComboBox x:Name="ProducerBox" Height="30" />

                <TextBlock Text="Поставщик:" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ComboBox x:Name="SupplierBox" Height="30" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Цена:" FontWeight="SemiBold" />
                        <TextBox x:Name="PriceBox" Height="30" VerticalContentAlignment="Center" Padding="6,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Единица измерения:" FontWeight="SemiBold" />
                        <ComboBox x:Name="UnitBox" Height="30" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Количество на складе:" FontWeight="SemiBold" />
                        <TextBox x:Name="StockBox" Height="30" VerticalContentAlignment="Center" Padding="6,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Действующая скидка (%):" FontWeight="SemiBold" />
                        <TextBox x:Name="DiscountBox" Height="30" VerticalContentAlignment="Center" Padding="6,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Сохранить" Style="{StaticResource AccentButton}"
                    Width="120" Click="Save_Click" />
            <Button Content="Назад" Style="{StaticResource StandardButton}"
                    Width="120" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
