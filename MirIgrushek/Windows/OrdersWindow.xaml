<Window x:Class="MirIgrushek.Windows.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="МирИгрушек — Заказы"
        Height="640" Width="860"
        WindowStartupLocation="CenterScreen"
        FontFamily="Arial"
        Background="{StaticResource MainBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Список заказов" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="AddOrderButton" Content="Добавить заказ"
                        Style="{StaticResource AccentButton}"
                        Click="AddOrderButton_Click" Visibility="Collapsed" />
                <Button x:Name="DeleteOrderButton" Content="Удалить заказ"
                        Style="{StaticResource StandardButton}"
                        Click="DeleteOrderButton_Click" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- Список заказов по макету Модуля 4 -->
        <ListView x:Name="OrdersList" Grid.Row="1"
                  BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="OrdersList_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="2" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10"
                            Background="{StaticResource SecondaryBackgroundBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <!-- Левый блок: артикул, статус, адрес, дата заказа -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding OrderArticle}" FontWeight="Bold" FontSize="14"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Статус заказа: " />
                                    <TextBlock Text="{Binding StatusName}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Адрес пункта выдачи: " />
                                    <TextBlock Text="{Binding PickupAddress}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Дата заказа: " />
                                    <TextBlock Text="{Binding OrderDate, StringFormat=dd.MM.yyyy}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Правый блок: дата доставки -->
                            <Border Grid.Column="1" BorderBrush="#999" BorderThickness="1"
                                    VerticalAlignment="Stretch">
                                <StackPanel VerticalAlignment="Center" Margin="6">
                                    <TextBlock Text="Дата доставки" FontSize="11"
                                               TextAlignment="Center" />
                                    <TextBlock Text="{Binding DeliveryDate, StringFormat=dd.MM.yyyy}"
                                               FontWeight="Bold" TextAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Нижняя панель -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Назад" Style="{StaticResource StandardButton}" Click="Back_Click" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#555" />
        </StackPanel>
    </Grid>
</Window>
