<Application x:Class="MirIgrushek.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:MirIgrushek.Helpers"
             StartupUri="Windows/LoginWindow.xaml">
    <Application.Resources>
        
        <!-- ============ Палитра по Руководству по стилю (Приложение 3) ============ -->
        <Color x:Key="MainBackgroundColor">#FFFFFFFF</Color>
        <Color x:Key="SecondaryBackgroundColor">#FFF5DEB3</Color>
        <Color x:Key="AccentColor">#FFDEB887</Color>

        <SolidColorBrush x:Key="MainBackgroundBrush" Color="{StaticResource MainBackgroundColor}" />
        <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

        <!-- ============ Конвертеры ============ -->
        <helpers:ProductRowBackgroundConverter x:Key="ProductRowBackgroundConverter" />
        <helpers:PhotoConverter x:Key="PhotoConverter" />
        <helpers:DiscountToVisibilityConverter x:Key="DiscountToVisibilityConverter" />

        <!-- ============ Базовый шрифт Arial для всего приложения ============ -->
        <Style TargetType="Control">
            <Setter Property="FontFamily" Value="Arial" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial" />
        </Style>

        <!-- Кнопка с акцентным цветом для целевых действий -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Обычная кнопка на дополнительном фоне -->
        <Style x:Key="StandardButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

    </Application.Resources>
</Application>
